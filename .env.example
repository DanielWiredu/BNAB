# ─── Database (Prisma — CRUD + introspection) ──────────────────────────────
# SQL Server. Named instances use a backslash: HOST\INSTANCE
# IMPORTANT: escape any `$` in passwords as `\$` — Next.js / dotenv-expand treat
# an unescaped `$` as a variable reference and will blank it out.
DATABASE_URL="sqlserver://HOST\\SQLEXPRESS;database=GDLCDB;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# ─── Database (node-mssql — stored procedure calls) ────────────────────────
MSSQL_SERVER="HOST"
MSSQL_INSTANCE="SQLEXPRESS"
MSSQL_DATABASE="GDLCDB"
MSSQL_USER="USER"
# Escape any `$` as `\$` (see note above).
MSSQL_PASSWORD="PASSWORD"
MSSQL_ENCRYPT="true"
MSSQL_TRUST_SERVER_CERT="true"

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME"
AUTH_URL="https://localhost:3000"
# Session sliding window in seconds (matches legacy 1-hour cookie)
AUTH_SESSION_MAX_AGE="3600"
# Security-stamp re-check interval in seconds (matches legacy 10-min revalidation)
AUTH_STAMP_REVALIDATE_SECONDS="600"

# ─── Email (Nodemailer over existing SMTP relay) ───────────────────────────
SMTP_HOST="mail.xcelisolutions.com"
SMTP_PORT="8889"
SMTP_USER="noreply@xcelisolutions.com"
SMTP_PASSWORD="CHANGE_ME"
SMTP_SENDER_NAME="GDLC LAMS"

# ─── Background jobs (BullMQ / Redis) — used from Phase 4 onward ────────────
# Local Redis/Memurai with no auth: REDIS_URL is fine as-is.
REDIS_URL="redis://localhost:6379"
# Managed/remote Redis with a password: prefer discrete vars instead of
# REDIS_URL — a password containing @ # $ ^ would need BOTH percent-encoding
# AND dotenv-expand escaping inside a single connection string (easy to get
# wrong — remember `\$` for a literal $, same as MSSQL_PASSWORD). Setting
# REDIS_HOST switches src/jobs/connection.ts to this discrete form.
# REDIS_HOST="redis.example.com"
# REDIS_PORT="6379"
# REDIS_USERNAME=""
# REDIS_PASSWORD="CHANGE_ME"
BRANCH_QUEUE="tema"

# ─── GPHA CLMS integration ─────────────────────────────────────────────────
# Shared secret the CLMS caller must present in the `x-clms-secret` header on
# inbound requests (new hardening). Left as CHANGE_ME/empty → header not enforced
# (so the feed keeps working before the caller is updated). Set at cutover.
CLMS_SHARED_SECRET="CHANGE_ME"
# Optional: verify the CompanyKey/CompanySecret in the labour-request payload.
# Only enforced when set (non-empty); leave blank to skip.
CLMS_COMPANY_KEY=""
CLMS_COMPANY_SECRET=""
# Optional JSON override for the GPHA level → GDLC trade-group id map used by the
# reconciliation job (defaults are baked in). e.g. {"Group 01": 30, "Group 02": 31}
CLMS_TRADE_GROUP_MAP=""

# ─── External legacy report app (RETIRED — ADR-007 revised) ────────────────
# No longer used. Loan Reports + Worker List are now native in-app reports
# (Phase 8); the remaining requisition reports are being rebuilt on the same
# engine. This var is kept only for reference and can be removed.
# REPORT_APP_URL="https://rptlams.gdlcwave.com"

# ─── Startup admin seeding ─────────────────────────────────────────────────
SEED_ADMIN_EMAILS="admin@example.com"
SEED_ADMIN_DEFAULT_PASSWORD=""
