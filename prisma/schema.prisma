/** vwMonthlyReq — monthly requisition list (joined company + worker name). */
model VwMonthlyReq {
  autoNo             Int      @map("AutoNo")
  reqNo              String   @id @map("ReqNo") @db.VarChar(10)
  date               DateTime @map("date_")
  dlecodeCompanyName String?  @map("DLEcodeCompanyName")
  workerId           String   @map("WorkerID") @db.VarChar(10)
  workerName         String?  @map("WorkerName")
  approved           Boolean? @map("Approved")
  confirmed          Boolean? @map("Confirmed")
  processed          Boolean? @map("Processed")

  @@map("vwMonthlyReq")
}

/** vwSubStaffWReq — weekly work days (joined vessel name). */
model VwSubStaffWreq {
  autoId           Int      @id @map("AutoId")
  reqNo            String   @map("ReqNo") @db.VarChar(10)
  transDate        DateTime @map("TransDate")
  normal           Float    @map("Normal")
  overtime         Float    @map("Overtime")
  night            String?  @map("Night") @db.VarChar(5)
  weekends         String?  @map("Weekends") @db.VarChar(7)
  holiday          String?  @map("Holiday") @db.VarChar(7)
  remarks          String?  @map("Remarks") @db.VarChar(50)
  vesselberthId    Int?     @map("VesselberthID")
  vesselName       String?  @map("VesselName")
  transport        String?  @map("Transport") @db.Char(1)
  onBoardAllowance Boolean  @map("OnBoardAllowance")
  shiftType        String?  @map("ShiftType") @db.VarChar(10)

  @@map("vwSubStaffWReq")
}

// ── Workers (Phase 2 — F2) ───────────────────────────────────────────────────
// Read-only views (introspected as models per ADR-002). Writes go through the
// stored procedures spAddWorker / spUpdateWorker / spSetWorkerStatus /
// spUpdateWorkerTrade (see src/db/procedures.ts). The binary Pics column is
// intentionally omitted (unused by the legacy form; image type).

/** vwWorkers — flat worker list with joined lookup names + status label. */
model VwWorker {
  workerId       String    @id @map("WorkerID") @db.VarChar(10)
  workerType     String    @map("WorkerType") @db.Char(1)
  sname          String?   @map("SName") @db.VarChar(30)
  oname          String?   @map("OName") @db.VarChar(50)
  dateBirth      DateTime? @map("Date_Birth")
  ssfno          String?   @map("SSFNo") @db.VarChar(30)
  nhis           String?   @map("NHIS") @db.VarChar(30)
  nat            String?   @map("NAT") @db.VarChar(30)
  gangName       String?   @map("GangName")
  tradegroupId   Int?      @map("TradegroupID")
  tradegroupName String?   @map("TradegroupNAME") @db.VarChar(50)
  tradetypeId    Int?      @map("TradetypeID")
  tradetypeName  String?   @map("TradetypeNAME") @db.VarChar(50)
  flags          String?   @map("flags") @db.VarChar(3)
  ezwichid       String?   @map("ezwichid") @db.VarChar(50)
  departmentId   Int?      @map("DepartmentId")
  bankNumber     String?   @map("BankNumber") @db.VarChar(30)
  sortCode       String?   @map("SortCode")
  regDate        DateTime? @map("RegDate")
  phoneNo        String?   @map("PhoneNo") @db.VarChar(20)
  kin            String?   @map("Kin") @db.VarChar(30)
  workerStatus   String?   @map("WorkerStatus")
  bankName       String?   @map("BankName")
  branchName     String?   @map("BranchName")
  nationalId     String?   @map("NationalID") @db.VarChar(50)

  @@map("vwWorkers")
}

/** vwTblWorkers — full worker record for the registration/edit form. */
model VwTblWorker {
  autoId        Int       @map("AutoID")
  workerId      String    @id @map("WorkerID") @db.VarChar(10)
