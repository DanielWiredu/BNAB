// GDLC LAMS — Prisma schema.
//
// IMPORTANT: The SQL Server database is AUTHORITATIVE and SHARED with the legacy
// apps. Do NOT run `prisma migrate` — never let Prisma alter this schema.
// Regenerate models from the live DB with:  npm run db:pull  (prisma db pull)
//
// The models below are hand-written for the ASP.NET Identity + audit tables so
// the app has typed access before introspection is run. `prisma db pull` will
// re-introspect and may rename these to match table names exactly — reconcile
// model names with the code once you run it (see docs/DB-MAPPING.md).
//
// NOTE: Phase-0 authentication does NOT depend on these Prisma models; it uses
// node-mssql (src/server/repositories/user-repository.ts) so login works
// regardless of introspection state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model AspNetUsers {
  id                   String    @id @map("Id") @db.NVarChar(450)
  userName             String?   @map("UserName") @db.NVarChar(256)
  normalizedUserName   String?   @map("NormalizedUserName") @db.NVarChar(256)
  email                String?   @map("Email") @db.NVarChar(256)
  normalizedEmail      String?   @map("NormalizedEmail") @db.NVarChar(256)
  emailConfirmed       Boolean   @map("EmailConfirmed")
  passwordHash         String?   @map("PasswordHash") @db.NVarChar(Max)
  securityStamp        String?   @map("SecurityStamp") @db.NVarChar(Max)
  concurrencyStamp     String?   @map("ConcurrencyStamp") @db.NVarChar(Max)
  phoneNumber          String?   @map("PhoneNumber") @db.NVarChar(Max)
  phoneNumberConfirmed Boolean   @map("PhoneNumberConfirmed")
  twoFactorEnabled     Boolean   @map("TwoFactorEnabled")
  lockoutEnd           DateTime? @map("LockoutEnd")
  lockoutEnabled       Boolean   @map("LockoutEnabled")
  accessFailedCount    Int       @map("AccessFailedCount")
  // Custom columns added by ApplicationUser
  name                 String?   @map("Name") @db.NVarChar(Max)
  userKey              String?   @map("UserKey") @db.NVarChar(Max)

  claims AspNetUserClaims[]
  roles  AspNetUserRoles[]

  @@map("AspNetUsers")
}

model AspNetRoles {
  id               String  @id @map("Id") @db.NVarChar(450)
  name             String? @map("Name") @db.NVarChar(256)
  normalizedName   String? @map("NormalizedName") @db.NVarChar(256)
  concurrencyStamp String? @map("ConcurrencyStamp") @db.NVarChar(Max)

  users AspNetUserRoles[]

  @@map("AspNetRoles")
}

model AspNetUserRoles {
  userId String @map("UserId") @db.NVarChar(450)
  roleId String @map("RoleId") @db.NVarChar(450)

  user AspNetUsers @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AspNetRoles @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("AspNetUserRoles")
}

model AspNetUserClaims {
  id         Int     @id @default(autoincrement()) @map("Id")
  userId     String  @map("UserId") @db.NVarChar(450)
  claimType  String? @map("ClaimType") @db.NVarChar(Max)
  claimValue String? @map("ClaimValue") @db.NVarChar(Max)

  user AspNetUsers @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AspNetUserClaims")
}

model tblAuditTrail {
  actionDate        DateTime @map("ActionDate")
  actionBy          String   @map("ActionBy") @db.VarChar(50)
  actionDescription String   @map("ActionDescription") @db.VarChar(100)
  actionId          String?  @map("ActionID") @db.VarChar(50)

  // Composite of all columns — the legacy table has no primary key.
  @@id([actionDate, actionBy, actionDescription])
  @@map("tblAuditTrail")
}

