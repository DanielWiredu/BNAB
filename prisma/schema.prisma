  tradegroupId  Int?      @map("TradegroupID")
  tradetypeId   Int?      @map("TradetypeID")
  gangId        Int?      @map("GangID")
  bankId        Int?      @map("BankID")
  bankBranchId  Int?      @map("BankBranchId")
  bankBranch    String?   @map("BankBranch") @db.VarChar(50)
  bankNumber    String?   @map("BankNumber") @db.VarChar(30)
  officialComm  String?   @map("OfficialComm") @db.VarChar(100)
  flags         String?   @map("flags") @db.VarChar(3)
  sex           String?   @map("Sex") @db.VarChar(1)
  tax           Boolean   @map("Tax")
  chargePremium Boolean   @map("ChargePremium")
  subheader     String?   @map("subheader") @db.VarChar(50)
  who           String?   @map("WHO") @db.VarChar(50)
  whotime       DateTime? @map("WHOtime")
