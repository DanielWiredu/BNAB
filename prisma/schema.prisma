}

// ── GPHA CLMS integration (Phase 4 — F5) ──────────────────────────────────────
// These tables are the inbound landing zone for the external GPHA CLMS feed and
// the reconciliation source. Columns mapped from sql/database-schema.sql.
// NOTE: inserting into GPHALabourRequests fires trg_Insert_GPHALabourRequests,
// which copies the row into tblGPHA_LabourRequests (the table the UI reads).

/** GPHALabourRequests — raw inbound labour-request landing table (idempotent on Id). */
model GPHALabourRequests {
  id              String   @id @map("Id") @db.UniqueIdentifier
  requestDate     DateTime @map("RequestDate")
  labourRequestId String?  @map("LabourRequestId") @db.NVarChar(255)
  unitDescription String?  @map("UnitDescription") @db.NVarChar(500)
  jobDescription  String?  @map("JobDescription") @db.NVarChar(Max)
  numberRequested Int      @map("NumberRequested")
  neededOn        DateTime @map("NeededOn")
  requestId       String?  @map("RequestId") @db.NVarChar(255)
  companySecret   String?  @map("CompanySecret") @db.VarChar(100)
  companyKey      String?  @map("CompanyKey") @db.VarChar(100)
  geoLocation     String?  @map("GeoLocation") @db.NVarChar(100)
  weekType        String?  @map("WeekType") @db.VarChar(50)
  shift           String?  @map("Shift") @db.VarChar(50)

  @@map("GPHALabourRequests")
}

/** GPHAJobAssignments — cost-sheet job assignment; Processed=0 rows drive reconcile. */
model GPHAJobAssignments {
  id               String   @id @map("Id") @db.UniqueIdentifier
  numberToSupply   Int      @map("NumberToSupply")
  job              String   @map("Job") @db.NVarChar(200)
  costSheetId      String?  @map("CostSheetId") @db.UniqueIdentifier
  neededOn         DateTime @map("NeededOn")
  shift            Boolean  @map("Shift")
  dayType          String   @map("DayType") @db.NVarChar(50)
  geoLocation      String   @map("GeoLocation") @db.NVarChar(200)
  unit             String   @map("Unit") @db.NVarChar(200)
  requestNumber    String   @map("RequestNumber") @db.NVarChar(50)
  dateAdded        DateTime @map("DateAdded")
  numberToSupplied Int      @map("NumberToSupplied")
  processed        Boolean? @map("Processed")

  @@map("GPHAJobAssignments")
}

/** GPHACostSheets — cost-sheet header (one per job assignment). */
model GPHACostSheets {
  id               String    @id @map("Id") @db.UniqueIdentifier
  jobAssignmentId  String    @map("JobAssignmentId") @db.UniqueIdentifier
  labourCompany    String    @map("LabourCompany") @db.NVarChar(200)
  companyId        String    @map("CompanyId") @db.UniqueIdentifier
  totalAmount      Decimal   @map("TotalAmount") @db.Decimal(18, 2)
  generatedDate    DateTime  @map("GeneratedDate")
  status           String    @map("Status") @db.NVarChar(50)
  shift            String    @map("Shift") @db.NVarChar(50)
  costSheetNumber  String    @map("CostSheetNumber") @db.NVarChar(50)
  dateAdded        DateTime  @map("DateAdded")
  paymentReference String?   @map("PaymentReference") @db.NVarChar(100)
  paymentStatus    Boolean   @map("PaymentStatus")
  processed        Boolean?  @map("Processed")
  processedDate    DateTime? @map("ProcessedDate")

  @@map("GPHACostSheets")
}

/** GPHACostSheetDetails — per-worker cost-sheet lines (hours, rate type, level). */
model GPHACostSheetDetails {
  id                  String    @id @map("Id") @db.UniqueIdentifier
  costSheetId         String    @map("CostSheetId") @db.UniqueIdentifier
  dateAdded           DateTime  @map("DateAdded")
  audited             Boolean   @map("Audited")
  auditedDate         DateTime? @map("AuditedDate")
  rateType            String    @map("RateType") @db.NVarChar(50)
  hoursWorked         Decimal   @map("HoursWorked") @db.Decimal(10, 2)
  baseRate            Decimal   @map("BaseRate") @db.Decimal(18, 2)
  premiumTotal        Decimal   @map("PremiumTotal") @db.Decimal(18, 2)
  nhilGflTotal        Decimal   @map("NHilGflTotal") @db.Decimal(18, 2)
  vatTotal            Decimal   @map("VatTotal") @db.Decimal(18, 2)
  transportationTotal Decimal   @map("TransportationTotal") @db.Decimal(18, 2)
  incentiveTotal      Decimal   @map("IncentiveTotal") @db.Decimal(18, 2)
  level               String    @map("Level") @db.NVarChar(50)
  jobDescription      String    @map("JobDescription") @db.NVarChar(200)
  worker              String    @map("Worker") @db.NVarChar(200)
  workerId            String    @map("WorkerId") @db.NVarChar(100)
  company             String    @map("Company") @db.NVarChar(200)
  shiftAllowance      Decimal   @map("ShiftAllowance") @db.Decimal(18, 2)
  nightAllowance      Decimal   @map("NightAllowance") @db.Decimal(18, 2)
  total               Decimal   @map("Total") @db.Decimal(18, 2)
  unit                String    @map("Unit") @db.NVarChar(200)
  auditedBy           String?   @map("AuditedBy") @db.NVarChar(100)
  overTimeHours       Decimal   @map("OverTimeHours") @db.Decimal(10, 2)
  overTimeRate        Decimal   @map("OverTimeRate") @db.Decimal(18, 2)
  groupIncentive      Decimal   @map("GroupIncentive") @db.Decimal(18, 2)

  @@map("GPHACostSheetDetails")
}

/** tblGPHA_LabourRequests — synced request list (pending/all/approved UI + reconcile). */
model TblGphaLabourRequest {
  id               Int       @id @default(autoincrement()) @map("Id")
  requestDate      DateTime? @map("RequestDate")
  labourRequestId  String    @map("LabourRequestID") @db.VarChar(50)
  unitDescription  String?   @map("UnitDescription") @db.VarChar(200)
  jobRequested     String?   @map("JobRequested") @db.VarChar(50)
  numberRequested  String?   @map("NumberRequested") @db.VarChar(50)
  neededOn         String?   @map("NeededOn") @db.VarChar(50)
  rNeededOn        DateTime? @map("rNeededOn")
  rDay             String?   @map("rDay") @db.VarChar(10)
  rShift           String?   @map("rShift") @db.VarChar(10)
  createdDate      DateTime? @map("CreatedDate")
  hasCostSheet     Boolean?  @map("hasCostSheet")
  costSheetNo      String?   @map("CostSheetNo") @db.VarChar(50)
  gphaApproved     Boolean?  @map("GPHA_Approved")
  gphaApprovedDate DateTime? @map("GPHA_ApprovedDate")
  syncDate         DateTime? @map("SyncDate")
  gdlcApproved     Boolean?  @map("GDLC_Approved")
  gdlcApprovedDate DateTime? @map("GDLC_ApprovedDate")

  @@map("tblGPHA_LabourRequests")
}

// ── Loans (Phase 7 — F9) ──────────────────────────────────────────────────────

/** tblLoanSchemes — loan scheme master (plain CRUD via Prisma). */
model tblLoanScheme {
  id          Int       @id @default(autoincrement()) @map("Id")
  loanScheme  String?   @map("LoanScheme") @db.VarChar(100)
  accountNo   String?   @map("AccountNo") @db.VarChar(30)
  createdDate DateTime? @map("CreatedDate")

  @@map("tblLoanSchemes")
}

/** tblLoans — loan header. Add/update/approve go through SPs; this model is used
    for the edit-form read and the raw delete. PK is LoanNo. LoanBalance is a
    computed column (LoanAmount − RepaidAmount) — read-only, never written. */
model tblLoan {
  autoId       Int       @map("AutoId")
  loanNo       String    @id @map("LoanNo") @db.VarChar(20)
  workerId     String?   @map("WorkerId") @db.VarChar(10)
  loanSchemeId Int       @map("LoanSchemeId")
  loanDate     DateTime  @map("LoanDate")
  loanAmount   Float?    @map("LoanAmount")
  repayAmount  Float?    @map("RepayAmount")
  monthlyLimit Float?    @map("MonthlyLimit")
  repaidAmount Float?    @map("RepaidAmount")
  loanBalance  Float?    @map("LoanBalance")
  repaid       Boolean?  @map("Repaid")
  autoDeduct   Boolean?  @map("AutoDeduct")
  approved     Boolean?  @map("Approved")
  approvedDate DateTime? @map("ApprovedDate")
  approvedBy   String?   @map("ApprovedBy") @db.VarChar(50)
  createdDate  DateTime? @map("CreatedDate")
  createdBy    String?   @map("CreatedBy") @db.VarChar(50)
  updatedDate  DateTime? @map("UpdatedDate")
  updatedBy    String?   @map("UpdatedBy") @db.VarChar(50)

  @@map("tblLoans")
}

/** tblLoanRepayments — repayment rows (list read + delete via SP). */
model tblLoanRepayment {
  autoId          Int       @id @default(autoincrement()) @map("AutoId")
  loanNo          String    @map("LoanNo") @db.VarChar(20)
  workerId        String    @map("WorkerId") @db.VarChar(10)
  repayDate       DateTime? @map("RepayDate")
  repayAmount     Float?    @map("RepayAmount")
  reqNo           String?   @map("ReqNo") @db.VarChar(20)
  approved        Boolean?  @map("Approved")
  approvedDate    DateTime? @map("ApprovedDate")
  approvedBy      String?   @map("ApprovedBy") @db.VarChar(50)
  createdDate     DateTime? @map("CreatedDate")
  createdBy       String?   @map("CreatedBy") @db.VarChar(50)
  manualReceiptNo String?   @map("ManualReceiptNo") @db.VarChar(50)

  @@map("tblLoanRepayments")
}

/** vwLoans — loan list with joined worker name + scheme + account (read-only). */
model VwLoan {
  autoId       Int       @map("AutoId")
  loanNo       String    @id @map("LoanNo") @db.VarChar(20)
  workerId     String?   @map("WorkerId") @db.VarChar(10)
  workerName   String?   @map("WorkerName")
  loanSchemeId Int       @map("LoanSchemeId")
  loanScheme   String?   @map("LoanScheme") @db.VarChar(100)
  loanDate     DateTime  @map("LoanDate")
  loanAmount   Float?    @map("LoanAmount")
  repayAmount  Float?    @map("RepayAmount")
  monthlyLimit Float?    @map("MonthlyLimit")
  repaidAmount Float?    @map("RepaidAmount")
  loanBalance  Float?    @map("LoanBalance")
  repaid       Boolean?  @map("Repaid")
  autoDeduct   Boolean?  @map("AutoDeduct")
  createdDate  DateTime? @map("CreatedDate")
  accountNo    String?   @map("AccountNo") @db.VarChar(30)
  approved     Boolean?  @map("Approved")

  @@map("vwLoans")
}
