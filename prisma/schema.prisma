// ── Trade & payroll setup (Phase 2 — F3) ─────────────────────────────────────
// Column names taken from sql/database-schema.sql (authoritative). ntext notes
// map to @db.NText. Rate/payroll tables are effective-dated: a new row is added
// via a stored procedure (which closes the prior row's EndDate); edits update in
// place. See src/db/procedures.ts (spAddTradeGroupRate / spAddPayrollSetup).

model tblTradeGroup {
  tradegroupId   Int     @id @default(autoincrement()) @map("TradegroupID")
  tradegroupName String? @map("TradegroupNAME") @db.VarChar(50)
  dnotes         String? @map("DNOTES") @db.NText
  gphaGroupId    String? @map("GPHA_GroupId") @db.VarChar(50)

  @@map("tblTradeGroup")
}

model tblTradeType {
  tradetypeId   Int     @id @default(autoincrement()) @map("TradetypeID")
  tradetypeName String? @map("TradetypeNAME") @db.VarChar(50)
  trnote        String? @map("TRNOTE") @db.NText
  tradegroupId  Int?    @map("TradegroupID")
  prefixname    String? @map("prefixname") @db.VarChar(5)
  gphaJobId     String? @map("GPHA_JobId") @db.VarChar(50)

  @@map("tblTradeType")
}

model tblTradeGroupRates {
  id                Int       @id @default(autoincrement()) @map("Id")
  tradegroupId      Int       @map("TradegroupID")
  dbwage            Float?    @map("DBWage")
  dbwageWkend       Float?    @map("DBWageWkend")
  dbwageHday        Float?    @map("DBWageHday")
  hourOtimeWkday    Float?    @map("HourOtimeWkday")
  hourOtimeWkend    Float?    @map("HourOtimeWkend")
  hourOtimeHday     Float?    @map("HourOtimeHday")
  nawkday           Float?    @map("NAWkday")
  nawkend           Float?    @map("NAWkend")
  nahday            Float?    @map("NAHday")
  shiftAllowance    Float?    @map("ShiftAllowance")
  transport         Float?    @map("Transport")
  subsidy           Float?    @map("Subsidy")
  ppemedical        Float?    @map("PPEMedical")
  bussing           Float?    @map("Bussing")
  dbwageDle         Float?    @map("DBWageDLE")
  dbwageWkendDle    Float?    @map("DBWageWkendDLE")
  hourOtimeWkdayDle Float?    @map("HourOtimeWkdayDLE")
  hourOtimeWkendDle Float?    @map("HourOtimeWkendDLE")
  nawkdayDle        Float?    @map("NAWkdayDLE")
  nawkendDle        Float?    @map("NAWkendDLE")
  effectiveDate     DateTime? @map("EffectiveDate")
  endDate           DateTime? @map("EndDate")
  createdDate       DateTime? @map("CreatedDate")
  createdBy         String?   @map("CreatedBy") @db.VarChar(50)
  updateStatus      Boolean?  @map("UpdateStatus")
  updatedBy         String?   @map("UpdatedBy") @db.VarChar(50)
  updatedDate       DateTime? @map("UpdatedDate")

  @@map("tblTradeGroupRates")
}

// ── Daily requisitions (Phase 3 — F4) ────────────────────────────────────────
// Writes go through stored procedures (spAddDailyReq / spUpdateDailyReq /
// spDeleteDailyReq / spAddSubStaffReq / spToogleWorkerTransport /
// spUpdateDailyReqHours). These models are used for reads only.

/** tblStaffReq — the daily requisition / cost-sheet header (read-only here). */
model tblStaffReq {
  autoNo           Int       @map("AutoNo")
  reqNo            String    @id @map("ReqNo") @db.VarChar(10)
  dlecodeCompanyId Int       @map("DLEcodeCompanyID")
  vesselberthId    Int?      @map("VesselberthID")
  locationId       Int?      @map("locationID")
  reportpointId    Int?      @map("ReportpointID")
  cargoId          Int?      @map("cargoID")
  gangId           Int?      @map("gangID")
  job              String?   @map("job") @db.VarChar(50)
  date             DateTime  @map("date_")
  normal           Float     @map("Normal")
  overtime         Float     @map("Overtime")
  weekends         Boolean   @map("Weekends")
  night            Boolean   @map("Night")
  shiftType        String?   @map("ShiftType") @db.VarChar(10)
  approved         Boolean   @map("Approved")
  adate            DateTime  @map("Adate")
  onBoardAllowance Boolean?  @map("OnBoardAllowance")
  processed        Boolean?  @map("Processed")
  stored           Boolean?  @map("Stored")
  gphaRequestId    String?   @map("GPHA_RequestID") @db.VarChar(50)

  @@map("tblStaffReq")
}

/** tblSubStaffReq — worker allocation rows. Adds go through spAddSubStaffReq;
    this model is used for the raw delete (RemoveSubStaffReq). */
model tblSubStaffReq {
  autoId       Int    @id @default(autoincrement()) @map("AutoId")
  reqNo        String @map("ReqNo") @db.VarChar(10)
  workerId     String @map("WorkerID") @db.VarChar(10)
  tradegroupId Int?   @map("TradegroupID")
  transport    String @map("transport") @db.Char(1)
  normal       Float? @map("Normal")
  overtime     Float? @map("Overtime")

  @@map("tblSubStaffReq")
}

/** vwDailyReq — requisition list with joined company/vessel/reporting-point. */
model VwDailyReq {
  autoNo             Int       @map("AutoNo")
  reqNo              String    @id @map("ReqNo") @db.VarChar(10)
  date               DateTime  @map("date_")
  approved           Boolean   @map("Approved")
  dlecodeCompanyName String?   @map("DLEcodeCompanyName")
  vesselName         String?   @map("VesselName")
  reportingPoint     String?   @map("ReportingPoint")
  submitted          Boolean?  @map("Submitted")
  processed          Boolean?  @map("Processed")
  hoursConfirmed     Boolean?  @map("HoursConfirmed")
  gphaRequestId      String?   @map("GPHA_RequestID")

  @@map("vwDailyReq")
}

/** vwSubStaffReq — workers allocated to a requisition (read-only). */
model VwSubStaffReq {
  autoId         Int     @id @map("AutoId")
  reqNo          String  @map("ReqNo") @db.VarChar(10)
  workerId       String  @map("WorkerID") @db.VarChar(10)
  sname          String? @map("SName") @db.VarChar(30)
  oname          String? @map("OName") @db.VarChar(50)
  tradetypeName  String? @map("TradetypeNAME") @db.VarChar(50)
  tradegroupName String? @map("TradegroupNAME") @db.VarChar(50)
  ezwichid       String? @map("ezwichid") @db.VarChar(50)
  transport      String? @map("transport") @db.Char(1)
  tradetypeId    Int?    @map("TradetypeID")
  normal         Float?  @map("Normal")
  overtime       Float?  @map("Overtime")

  @@map("vwSubStaffReq")
}

// ── Weekly & monthly requisitions (Phase 5 — F6) ─────────────────────────────
// Writes go through stored procedures. These models are read-only; the header
// tables are per-worker (WorkerID on the requisition itself).

