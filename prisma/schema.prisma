  approved         Boolean?  @map("Approved")
  processed        Boolean?  @map("Processed")
  stored           Boolean?  @map("Stored")
  confirmed        Boolean?  @map("Confirmed")
  duplicateShift   Boolean?  @map("DuplicateShift")

  @@map("tblStaffWReq")
}

model tblStaffMReq {
  autoNo           Int       @map("AutoNo")
